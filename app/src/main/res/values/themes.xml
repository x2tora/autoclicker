<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoClicker" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.AutoClicker.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1B1C23</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AutoClicker</item>
    </style>
</resources>
